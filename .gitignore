# ---- Hexo ----
node_modules/
public/
db.json
.deploy_git/
*.log

# ---- 由 files/ 同步生成,源文件在 files/ ----
source/files/*
!source/files/index.md

# ---- 脚本运行时产生的临时目录 ----
.deploy-tmp/
.avatar-tmp/
.wallpaper-tmp/
.notebook-tmp/
.gh-pages-worktree/

# ---- 随手放的草稿 / 密钥,别误提交 ----
.env
.env.*
*.local
.draft-*

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
*.swp

# ---- VSCode 插件已经搬到独立仓库,这里只留一条防线 ----

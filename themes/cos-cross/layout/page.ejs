<article class="page">
  <header class="page-hero page-hero-inner">
    <% if (page.kicker) { %><p class="page-kicker"><%= page.kicker %></p><% } %>
    <h1 class="page-title grad-text"><%= page.title %></h1>
    <% if (page.subtitle) { %><p class="page-sub"><%= page.subtitle %></p><% } %>
  </header>

  <div class="post-content page-content" id="post-content">
    <%- page.content %>
  </div>
</article>

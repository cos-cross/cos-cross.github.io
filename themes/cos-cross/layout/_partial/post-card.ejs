<%
  var plain = strip_html(post.content || '').replace(/\s+/g, '');
  var readMin = Math.max(1, Math.ceil(plain.length / 350));
  var excerptText = post.excerpt
    ? truncate(strip_html(post.excerpt), 96)
    : truncate(strip_html(post.content || ''), 96);
  var postCats = post.categories && post.categories.length ? post.categories.toArray() : [];
  var postTags = post.tags && post.tags.length ? post.tags.toArray() : [];
%>
<article class="post-card reveal">
  <a class="post-card-link" href="<%= url_for(post.path) %>">
    <span class="post-card-beam" aria-hidden="true"></span>
    <header class="post-card-head">
      <span class="post-card-cat">
        <%- partial('_partial/icon', { name: 'folder', size: 12 }) %>
        <%= postCats.length ? postCats[0].name : '随笔' %>
      </span>
      <time class="post-card-date" datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'YYYY-MM-DD') %></time>
    </header>

    <h3 class="post-card-title"><%= post.title %></h3>
    <p class="post-card-excerpt"><%= excerptText %></p>

    <footer class="post-card-foot">
      <span class="post-card-meta">
        <%- partial('_partial/icon', { name: 'clock', size: 12 }) %>≈ <%= readMin %> 分钟
      </span>
      <span class="post-card-tags">
        <% postTags.slice(0, 3).forEach(function (tag) { %>
        <span class="mini-tag">#<%= tag.name %></span>
        <% }); %>
      </span>
      <span class="post-card-go"><%- partial('_partial/icon', { name: 'arrowRight', size: 14 }) %></span>
    </footer>
  </a>
</article>

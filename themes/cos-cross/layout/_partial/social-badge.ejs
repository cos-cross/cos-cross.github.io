<%
  // 社交链接统一渲染成 shields.io 徽章:页脚「找到我」和手机端菜单底部共用这一份标记,
  // 免得两边各写一份慢慢写歪。
  // 调用:partial('_partial/social-badge', { item: item, cls: 'nav-social' })
  var extraCls = (typeof cls === 'string' && cls) ? ' class="' + cls + '"' : '';
  var label = item.name || 'link';
%>
<a<%- extraCls %> href="<%= item.link %>" target="_blank" rel="noopener noreferrer" title="<%= label %>">
  <img class="social-badge" src="<%= social_badge_url(item) %>" alt="<%= label %>" height="20" loading="lazy" decoding="async">
</a>

    <author>
      <name>Cos-Cross</name>
    </author>
    <category term="编程" scheme="https://cos-cross.github.io/categories/%E7%BC%96%E7%A8%8B/"/>
    <category term="Hexo" scheme="https://cos-cross.github.io/tags/Hexo/"/>
    <category term="Python" scheme="https://cos-cross.github.io/tags/Python/"/>
    <category term="工具链" scheme="https://cos-cross.github.io/tags/%E5%B7%A5%E5%85%B7%E9%93%BE/"/>

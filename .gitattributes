# 统一换行符:仓库里一律用 LF,避免 Windows 上 diff 全是整行变化
* text=auto eol=lf

# 这些是二进制,不要做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary

# 生成物不要出现在 diff 统计里
package-lock.json linguist-generated=true
themes/cos-cross/source/vendor/katex/** linguist-vendored=true

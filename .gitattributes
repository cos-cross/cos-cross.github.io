# 统一换行符:代码和文档一律用 LF,避免 Windows 上 diff 全是整行变化
* text=auto eol=lf

# 但 files/ 里是"要原样分享给别人的文件",必须字节级不变 ——
# 一旦 git 在这里偷偷改换行符,下载页上标的 sha256 就和下载到的文件对不上,
# 校验功能会变成假的。所以整个目录关掉文本转换。
files/** -text

# 这些是二进制,不要做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary

# 生成物不要出现在 diff 统计里
package-lock.json linguist-generated=true
themes/cos-cross/source/vendor/katex/** linguist-vendored=true
